<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.coinseconomy</groupId>
    <artifactId>CoinsEconomy</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>CoinsEconomy</name>
    <description>Plugin de economia (coins) baseado na API do Vault, para Paper 26.3</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            Paper 26.3 exige Java 25 para desenvolvimento e execução.
            O plugin é compilado diretamente para Java 25.
        -->
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <repositories>
        <!-- Repositório oficial do Paper -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <!-- JitPack: usado para obter a VaultAPI (MilkBowl/Vault) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API do Paper para o Minecraft 26.3 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.3.build,)</version>
            <scope>provided</scope>
        </dependency>

        <!-- API do Vault, usada só em tempo de compilação (o Vault já
             fica instalado no servidor como plugin separado) -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
